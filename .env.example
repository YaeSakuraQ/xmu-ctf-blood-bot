# ============ 平台（必填） ============
# 实训平台地址，不要带结尾斜杠
CTF_BASE_URL=http://<platform-host>
# 赛事 ID（后台赛事列表/大屏链接里）
CTF_RACE_ID=
# 赛事大屏 viewer_key（32 位十六进制，后台大屏链接最后一段）
CTF_VIEWER_KEY=
# 播报目标 QQ 群号
CTF_GROUP_ID=

# ============ 播报行为 ============
# 轮询间隔（秒），建议 2
CTF_POLL_INTERVAL=2
# 两条消息之间的最小间隔（秒），建议 1，避免 QQ 风控
CTF_SEND_INTERVAL=1
# 启动时发现已有血：announce=补报，silent=静默基线
CTF_CATCHUP_MODE=announce
# 播报哪些血位：1,2,3 表示一/二/三血
CTF_BLOOD_LEVELS=1,2,3
# true 时只打印不发送（联调用）
CTF_DRY_RUN=false
# 容器内数据库路径
CTF_DB_PATH=/app/data/ctf_blood.sqlite3
# 发送失败最多重试次数
CTF_MAX_SEND_ATTEMPTS=5
# 发送失败是否私聊管理员
CTF_SEND_ADMIN_ERRORS=true

# ============ NoneBot ============
HOST=0.0.0.0
PORT=8080
# 与 NapCat 反向 WS 的 token 一致（deploy.sh 会写入 NapCat 配置）
ONEBOT_ACCESS_TOKEN=change-me-to-a-random-token
# 机器人管理员 QQ，JSON 列表；改成你自己的 QQ
SUPERUSERS=["123456789"]
COMMAND_START=["/"]
COMMAND_SEP=["."]
LOG_LEVEL=INFO

# ============ NapCat ============
# WebUI 登录 token，自己生成一个随机串
NAPCAT_TOKEN=change-me-to-another-random-token
TZ=Asia/Shanghai
